# feedback-o-tron — HTTP intake image.
# Build from the repository root:
#   podman build -f packaging/Containerfile -t feedback-o-tron .

# ---- Stage 1: build the OTP release -----------------------------------
FROM cgr.dev/chainguard/wolfi-base@sha256:9a8d954d8f03a21bcf2be73d4628f0ad26d35c3275469925de63a34eebd58f13 AS builder

RUN apk add --no-cache elixir erlang git build-base

WORKDIR /build/elixir-mcp

# Dependencies first, so a source-only change does not refetch them.
COPY elixir-mcp/mix.exs elixir-mcp/mix.lock ./
RUN mix local.hex --force && \
    mix local.rebar --force && \
    MIX_ENV=prod mix deps.get --only prod

COPY elixir-mcp/ ./
RUN MIX_ENV=prod mix release

# ---- Stage 2: runtime -------------------------------------------------
FROM cgr.dev/chainguard/wolfi-base@sha256:9a8d954d8f03a21bcf2be73d4628f0ad26d35c3275469925de63a34eebd58f13 AS runtime

# `mix release` bundles ERTS, so no erlang package here — only the shared
# libraries it links against.
RUN apk add --no-cache ca-certificates ncurses openssl libstdc++

RUN adduser -D -u 1000 feedback
USER feedback
WORKDIR /home/feedback

COPY --from=builder --chown=feedback:feedback \
    /build/elixir-mcp/_build/prod/rel/feedback_a_tron ./release/

# The HTTP intake is the only door this image opens. It binds all
# interfaces because the container has its own network namespace; publish
# it with `-p 127.0.0.1:7722:7722` to keep it on the host's loopback.
ENV LANG=C.UTF-8 \
    HOME=/home/feedback \
    FEEDBACK_O_TRON_HTTP=1 \
    FEEDBACK_O_TRON_HTTP_PORT=7722 \
    FEEDBACK_O_TRON_HTTP_BIND=0.0.0.0

EXPOSE 7722

ENTRYPOINT ["/home/feedback/release/bin/feedback_a_tron"]
CMD ["start"]

HEALTHCHECK --interval=30s --timeout=3s \
    CMD /home/feedback/release/bin/feedback_a_tron pid || exit 1

LABEL org.opencontainers.image.title="feedback-o-tron" \
      org.opencontainers.image.description="Feedback and bug-report submission for people and AI agents" \
      org.opencontainers.image.source="https://github.com/hyperpolymath/feedback-o-tron" \
      org.opencontainers.image.licenses="MPL-2.0"
