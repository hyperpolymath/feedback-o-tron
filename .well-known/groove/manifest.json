{
  "groove_version": "1",
  "service_id": "feedback-o-tron",
  "service_version": "1.0.0",
  "mode": "passive",
  "capabilities": {
    "bug-reporting": {
      "type": "bug-reporting",
      "description": "Multi-platform feedback and bug-report submission for people and AI agents — GitHub, GitLab, Bitbucket, Codeberg, Bugzilla and email",
      "protocol": "cli",
      "requires_auth": true,
      "panel_compatible": true
    },
    "dogfood-feedback": {
      "type": "dogfood-feedback",
      "description": "Receives DOG-XX check failures from dogfood-gate and drafts actionable issues",
      "protocol": "cli",
      "requires_auth": true,
      "panel_compatible": true
    }
  },
  "consumes": [
    "static-analysis",
    "octad-storage",
    "bot-orchestration"
  ],
  "invoke_patterns": {
    "ci": "feedback-o-tron submit --repo OWNER/REPO --title TITLE --body BODY --dry-run",
    "local": "feedback-o-tron submit --repo OWNER/REPO --title TITLE --body BODY",
    "mcp": "feedback-o-tron serve"
  },
  "health": "/health",
  "applicability": [
    "individual",
    "team",
    "ci"
  ]
}
