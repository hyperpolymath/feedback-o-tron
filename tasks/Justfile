# feedback-a-tron - Guix Development Tasks
set shell := ["bash", "-uc"]
set dotenv-load := true

project := "feedback-a-tron"

# Show all recipes
default:
    @just --list --unsorted

# Build with guix
build:
    guix build

# Build and show output path
build-show:
    guix build --print-out-paths

# Enter dev shell
develop:
    guix develop

# Check flake
check:
    guix flake check

# Update flake inputs
update:
    guix flake update

# Show flake info
info:
    guix flake info

# Format guix files
fmt:
    nixfmt *.guix || guix fmt

# Run guix linter
lint:
    statix check . || true

# Clean
clean:
    rm -rf result

# Show derivation
show-drv:
    guix derivation show

# All checks before commit
pre-commit: check
    @echo "All checks passed!"

secret-scan-trufflehog:
    @command -v trufflehog >/dev/null && trufflehog filesystem . --only-verified || true
